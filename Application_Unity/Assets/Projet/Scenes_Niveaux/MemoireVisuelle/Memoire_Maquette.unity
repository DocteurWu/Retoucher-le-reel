  m_Script: {fileID: 11500000, guid: 198dbc19da9eff7459ab443c35750831, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  nomEtape: "\xC9preuve"
  consigne: 
  felicitation: 
  niveau: {fileID: 11400000, guid: aca30e3f8ad14cb41a698d8b900491df, type: 2}
  niveauxSuivants:
  - {fileID: 11400000, guid: 0b67440e41a76e948a7346fd4dde2055, type: 2}
  objets: []
  demarrerAuLancement: 1
  delaiIntro: 5
  commandesDemo: 1
  texteIntro: "Observe bien la pi\xE8ce : tu vas devoir te souvenir de chaque objet.
    Fais le tour, prends ton temps."
  textePret: "Quand tu es pr\xEAt, touche le bouton devant toi."
  texteMelange: "Quelque chose a chang\xE9. Remets chaque objet \xE0 sa place."
  texteMelangeTaille: "Des objets ont chang\xE9 de place, et certains de taille.
    Retrouve leur place et leur taille d'origine."
  texteValider: Quand tu as fini, touche le bouton devant toi.
  texteReussite: "Bravo ! Tu as une excellente m\xE9moire."
  texteEchec: "Pas tout \xE0 fait. Regarde o\xF9 ils devaient \xEAtre."
